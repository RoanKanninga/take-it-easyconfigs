name = 'PGx'
version = '2.2.0'

homepage = 'https://github.com/molgenis/PGx-pipeline'
description = """Pharmacogenetics pipeline"""

toolchain = SYSTEM
easyblock = 'PackedBinary'

source_urls = [('http://github.com/molgenis/PGx-pipeline/archive/refs/tags/')]
sources = [('%s.tar.gz' % (version))]

checksums = ['feb18a28a6bad4abe7b13fb2ca660f4fc645d7a55915a4e7c7077f05fab731e8']

dependencies = [
	('Perl', '5.34.1', '-bare', ('GCCcore', '11.3.0')),
	('Python', '3.10.4', '-bare', ('GCCcore', '11.3.0')),
	('nextflow', '21.10.6', '-Java-11-LTS'),
	('Molgenis-Compute', '20.03.1', '-Java-11-LTS'),
	('asterix', '1.1', ''),
	('BeadArrayFiles','1.3.3', '-Python-3.10.4', ('foss','2022a')),
	('R','4.4.0', '-bare', ('foss','2022a')),
	('PLINK', '2.0-alpha4.5-20230813', ''),
	('PLINK', '1.9-beta6-20190617', ''),
	('opticall','0.8.1', '', ('GCCcore', '11.3.0')),
	('gtc2vcf', '20251010_553eb30', '', ('GCCcore', '13.3.0')),
]

sanity_check_paths = {
    'files': ['protocols/sample_filtering.sh'],
    'dirs': []
}

moduleclass = 'bio'
