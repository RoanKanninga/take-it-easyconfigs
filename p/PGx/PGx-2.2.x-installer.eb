	('Perl', '5.34.1', '-bare', ('GCCcore', '11.3.0')),
	('Python', '3.10.4', '-bare', ('GCCcore', '11.3.0')),
	('nextflow', '21.10.6', '-Java-11-LTS'),
	('Molgenis-Compute', '20.03.1', '-Java-11-LTS'),
	('asterix', '1.1', ''),
	('BeadArrayFiles','1.3.3', '-Python-3.10.4', ('foss','2022a')),
	('R','4.4.0', '-bare', ('foss','2022a')),
	('PLINK', '2.0-alpha4.5-20230813', ''),
	('PLINK', '1.9-beta6-20190617', ''),
	('opticall','0.8.1', '', ('GCCcore', '11.3.0')),
	('gtc2vcf', '20251010_553eb30', '', ('GCCcore', '13.3.0')),
]
